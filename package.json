{
	"name": "store-env",
	"version": "0.1.0",
	"description": "Simple store for environment variables",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SimonJang/store-env.git"
	},
	"packageManager": "npm@12.0.1",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"author": {
		"name": "Simon Jang",
		"email": "simon.jang.contact@gmail.com",
		"url": "https://github.com/SimonJang"
	},
	"engines": {
		"node": ">=12"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('lib', {recursive: true, force: true})\"",
		"build": "npm run clean && tsc --project tsconfig.json",
		"test:types": "tsc --project tsconfig.test.json",
		"test": "npm run build && node --test test/store-env.test.js && npm run test:types",
		"prepack": "npm test"
	},
	"files": [
		"lib"
	],
	"keywords": [
		"immutable",
		"environment variables"
	],
	"devDependencies": {
		"typescript": "7.0.2"
	}
}
