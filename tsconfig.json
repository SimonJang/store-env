{
	"compilerOptions": {
		"target": "ES2018",
		"module": "Node16",
		"moduleResolution": "Node16",
		"declaration": true,
		"removeComments": true,
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noEmitOnError": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"rootDir": "source",
		"outDir": "lib"
	},
	"include": ["source/index.ts"]
}
